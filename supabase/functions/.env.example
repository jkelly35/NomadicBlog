# Supabase runtime
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Strava OAuth app
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
STRAVA_CALLBACK_URL=https://YOUR_PROJECT_REF.functions.supabase.co/strava-connect-callback
STRAVA_STATE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional runtime overrides
STRAVA_POST_CONNECT_REDIRECT=https://nomadicperformance.com/profile.html
STRAVA_OAUTH_SCOPES=read,activity:read_all,profile:read_all
STRAVA_OAUTH_PROMPT=auto

# Whoop OAuth app
WHOOP_CLIENT_ID=YOUR_WHOOP_CLIENT_ID
WHOOP_CLIENT_SECRET=YOUR_WHOOP_CLIENT_SECRET
WHOOP_CALLBACK_URL=https://YOUR_PROJECT_REF.functions.supabase.co/whoop-connect-callback
WHOOP_STATE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional Whoop runtime overrides
WHOOP_POST_CONNECT_REDIRECT=https://nomadicperformance.com/profile.html
WHOOP_OAUTH_SCOPES="read:recovery read:sleep read:workout"
WHOOP_AUTH_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_API_BASE=https://api.prod.whoop.com/developer/v1
WHOOP_RECOVERY_PATH=/recovery
WHOOP_SLEEP_PATH=/sleep
WHOOP_WORKOUT_PATH=/workout
WHOOP_START_PARAM=start_date
WHOOP_END_PARAM=end_date
# Optional revoke endpoint. If unset, disconnect only removes local rows.
WHOOP_REVOKE_URL=
